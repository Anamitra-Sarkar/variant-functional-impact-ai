# Environment variables for Variant Functional Impact AI
# Copy to .env and fill in real values where needed. Never commit real secrets.

# --- Backend release gate (fail-closed; both required to serve predictions) ---
# MODEL_RELEASE_APPROVED: must be "true" to load model artifact; any other value keeps gate closed (safe default)
MODEL_RELEASE_APPROVED=false
# APPROVED_ARTIFACT_REVISION: non-empty revision string for loaded artifact (e.g. git SHA or version tag); required when gate is open
APPROVED_ARTIFACT_REVISION=
# MODEL_ARTIFACT_PATH: filesystem path inside backend container/host to pickle artifact (default: artifacts/model.pkl)
MODEL_ARTIFACT_PATH=artifacts/model.pkl

# --- Backend auth (Firebase-shaped) ---
# FIREBASE_SERVICE_ACCOUNT_JSON: path to Firebase service account JSON file; if unset or file missing, auth is permissive in dev (documented)
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Frontend ---
# VITE_API_URL: base URL for backend API; empty string means same-origin / dev proxy. Example: http://localhost:8000 for local dev
VITE_API_URL=http://localhost:8000
# VITE_API_BASE: deprecated alias for VITE_API_URL (kept for backward compat; prefer VITE_API_URL)
VITE_API_BASE=
